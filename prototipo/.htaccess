# ============================================================
#  nutriplat.com.br — política de cache
#
#  O problema que isto resolve: a Hostinger servia TUDO com
#  max-age de 7 dias. Como o HTML também ficava preso, publicar
#  uma correção não chegava em ninguém — nem na Ana — sem
#  Ctrl+Shift+R, e o service worker do portal ainda regravava a
#  versão velha por cima.
#
#  A regra agora: o HTML (e o service worker) sempre perguntam ao
#  servidor se mudou; os assets podem ficar cacheados para sempre
#  porque a URL deles carrega o hash do conteúdo
#  (scripts/versionar_assets.py) — arquivo novo, URL nova.
# ============================================================

<IfModule mod_headers.c>
  # Assets versionados: cache longo. A URL muda quando o conteúdo muda.
  <FilesMatch "\.(js|css|png|jpe?g|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # HTML e manifest: revalidar sempre (é barato, responde 304).
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # O service worker por último, para vencer a regra de .js acima:
  # ele é quem decide o cache de todo o resto, não pode envelhecer.
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

# ============================================================
#  URL limpa — /pacientes serve pacientes.html, e /pacientes.html
#  redireciona (301) para /pacientes. Estas regras já existiam e
#  foram perdidas quando este arquivo passou a tratar cache; sem
#  elas, todo endereço sem .html devolvia 404.
# ============================================================
Options -MultiViews
RewriteEngine On

# 0) www -> endereço sem www, permanente. Sem isto o site abria duplicado
#    nos dois nomes e só o canonical dizia ao Google qual era o certo.
RewriteCond %{HTTP_HOST} ^www\.nutriplat\.com\.br$ [NC]
RewriteRule ^(.*)$ https://nutriplat.com.br/$1 [R=301,L]

# 1) link velho com .html -> endereço sem extensão, permanente.
#    Exceção: o arquivo de verificação do Search Console (google<hash>.html)
#    tem de responder 200 no endereço exato; com redirect o Google não verifica.
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) /index -> raiz.
RewriteRule ^index/?$ / [R=301,L]

# 2.1) Perfil público da nutricionista: /nutri/ana-luisa-rocha -> nutri.html?slug=...
#      O endereço com o nome dentro é o que a profissional divulga e o que o
#      Google indexa; nutri.html?slug= continua funcionando, mas ninguém vê.
#      Precisa vir ANTES da regra 3: "nutri/ana-luisa-rocha" também casa com
#      o padrão dela, que procuraria um arquivo nutri/ana-luisa-rocha.html
#      inexistente e devolveria 404.
RewriteRule ^nutri/([A-Za-z0-9-]+)/?$ /nutri.html?slug=$1 [L,QSA]

# 2.2) /nutri sem ninguém depois não é página: manda para a busca.
#      A condição preserva /nutri?slug=..., que é para onde a regra 1 joga
#      quem chega pelo link antigo com .html.
RewriteCond %{QUERY_STRING} !(^|&)slug=
RewriteRule ^nutri/?$ /encontre-sua-nutri [R=301,L]

# ============================================================
#  Comunidade — desligada.
#  A tela é 100% de demonstração: 26 posts com autores, CRNs e
#  especialidades inventados, e o composer assinava tudo como
#  "Ana Luísa Rocha — CRN-3 12345", um registro que não existe.
#  A faxina de 20/09/2026 já a tirou do menu, mas /comunidade
#  continuava respondendo 200 para quem soubesse o endereço.
#  O arquivo segue no repositório: para religar a tela basta
#  apagar este bloco.
# ============================================================
RewriteRule ^comunidade(\.html)?/?$ /dashboard [R=302,L]

# ============================================================
#  Retorno do OAuth do Google (Agenda + Meet)
#  O redirect URI registrado no Google fica no domínio próprio,
#  porque a verificação do app exige domínio comprovado no Search
#  Console (supabase.co não dá). Repassa code/state para a function.
# ============================================================
RewriteRule ^google-callback/?$ https://btsqrpxzlkmucrfvsytl.supabase.co/functions/v1/google-oauth-callback [R=302,L]

# 3) endereço sem extensão -> arquivo .html correspondente.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+?)/?$ /$1.html [L]
